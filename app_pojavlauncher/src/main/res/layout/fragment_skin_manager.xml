<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0f13"
    android:padding="@dimen/_18sdp">

    <TextView
        android:id="@+id/skin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/skin_manager_title"
        android:textColor="#f5fbff"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/skin_import_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/button_lunar_play"
        android:minHeight="0dp"
        android:paddingHorizontal="@dimen/_20sdp"
        android:text="@string/skin_manager_pick"
        android:textAllCaps="false"
        android:textColor="#00131f"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/skin_title" />

    <net.kdt.pojavlaunch.skins.SkinPreviewView
        android:id="@+id/skin_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="@drawable/panel_lunar_glass"
        app:layout_constraintBottom_toTopOf="@id/skin_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skin_title" />

    <TextView
        android:id="@+id/skin_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/skin_manager_empty"
        android:textColor="#8d99a4"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
